{
    "name": "adaptit-darshan/exception-notifier",
    "description": "Production-ready exception notification system for Laravel 8-13 with intelligent rate limiting, critical exception handling, and customizable email templates. Supports Laravel 8, 9, 10, 11, 12, and 13.",
    "keywords": [
        "laravel",
        "exception",
        "notifier",
        "email",
        "notification",
        "error",
        "monitoring",
        "alert",
        "rate-limiting",
        "laravel-8",
        "laravel-9",
        "laravel-10",
        "laravel-11",
        "laravel-12",
        "laravel-13"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Darshan Baraiya",
            "email": "darshan@adaptit.co.uk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/config": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/log": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "symfony/error-handler": "^5.1|^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^1.0|^2.0",
        "rector/rector": "^0.15|^1.0",
        "pestphp/pest": "^1.0|^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^1.0|^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "AdaptItDarshan\\ExceptionNotifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdaptItDarshan\\ExceptionNotifier\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "refactor": "vendor/bin/rector process"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AdaptItDarshan\\ExceptionNotifier\\Providers\\ExceptionNotifierServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
